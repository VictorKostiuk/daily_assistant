- flash.each do |type, message|
  - next if message.blank?
  - tone = type.to_s == "alert" ? "border-rose-200 bg-rose-50 text-rose-800" : "border-emerald-200 bg-emerald-50 text-emerald-800"
  %div{ class: "fixed left-1/2 top-4 z-50 w-[calc(100%-2rem)] max-w-xl -translate-x-1/2 rounded-lg border px-4 py-3 text-sm font-medium shadow-lg #{tone}", role: "status" }
    = message
