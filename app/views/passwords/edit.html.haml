- content_for :title, t("devise.passwords.edit.meta.title")

%main.min-h-screen.bg-stone-50.px-6.py-10.lg:px-8
  %div{ class: "mx-auto flex min-h-[calc(100vh-5rem)] max-w-md flex-col justify-center" }
    .mx-auto.inline-flex.items-center.gap-3
      %span.flex.h-10.w-10.items-center.justify-center.rounded-lg.bg-white.shadow-sm.ring-1.ring-slate-200
        = image_tag app_icon_path, alt: "", class: "h-6 w-6"
      %span.text-sm.font-semibold.text-slate-950= t("app.name")

    %div{ class: "mt-10 rounded-lg border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/70 sm:p-8" }
      %h1.text-2xl.font-semibold.text-slate-950= t("devise.passwords.edit.title")
      %p.mt-2.text-sm.leading-6.text-slate-600= t("devise.passwords.edit.subtitle")

      - if @user&.errors&.any?
        .mt-6.rounded-lg.border.border-rose-200.bg-rose-50.p-4.text-sm.text-rose-800
          %ul.list-disc.space-y-1.pl-5
            - @user.errors.full_messages.each do |message|
              %li= message

      = form_with url: auth_password_path, method: :put, html: { class: "mt-8 space-y-5" } do
        = hidden_field_tag :reset_password_token, @reset_password_token

        .space-y-2
          = label_tag :password, t("devise.passwords.edit.form.password"), class: "block text-sm font-medium text-slate-700"
          = password_field_tag :password, nil, autofocus: true, autocomplete: "new-password", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-sm text-slate-950 shadow-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
          %p.text-xs.text-slate-500= t("devise.passwords.edit.form.password_hint", count: Devise.password_length.min)

        .space-y-2
          = label_tag :password_confirmation, t("devise.passwords.edit.form.password_confirmation"), class: "block text-sm font-medium text-slate-700"
          = password_field_tag :password_confirmation, nil, autocomplete: "new-password", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-sm text-slate-950 shadow-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"

        = submit_tag t("devise.passwords.edit.form.submit"), class: "w-full cursor-pointer rounded-lg bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
