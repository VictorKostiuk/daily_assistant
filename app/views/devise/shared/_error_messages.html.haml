- if resource.errors.any?
  .rounded-lg.border.border-rose-200.bg-rose-50.p-4.text-sm.text-rose-800
    %p.font-semibold= t("errors.messages.not_saved", count: resource.errors.count, resource: resource.class.model_name.human.downcase)
    %ul.mt-3.list-disc.space-y-1.pl-5
      - resource.errors.full_messages.each do |message|
        %li= message
