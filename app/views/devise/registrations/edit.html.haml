- content_for :title, t(".meta.title")

%main.min-h-screen.bg-stone-50.px-6.py-10.lg:px-8
  .mx-auto.max-w-3xl
    = link_to root_path, class: "inline-flex items-center gap-3" do
      %span.flex.h-10.w-10.items-center.justify-center.rounded-lg.bg-white.shadow-sm.ring-1.ring-slate-200
        = image_tag public_icon_path("icon.svg"), alt: "", class: "h-6 w-6"
      %span.text-sm.font-semibold.text-slate-950= t("app.name")

    %div{ class: "mt-10 rounded-lg border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/70 sm:p-8" }
      %h1.text-2xl.font-semibold.text-slate-950= t(".title")
      %p.mt-2.text-sm.leading-6.text-slate-600= t(".subtitle")

      = render "devise/shared/error_messages", resource: resource

      = form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "mt-8 space-y-5" }) do |f|
        .grid.gap-4.sm:grid-cols-2
          .space-y-2
            = f.label :first_name, t(".form.first_name"), class: "block text-sm font-medium text-slate-700"
            = f.text_field :first_name, autocomplete: "given-name", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-sm text-slate-950 shadow-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
          .space-y-2
            = f.label :last_name, t(".form.last_name"), class: "block text-sm font-medium text-slate-700"
            = f.text_field :last_name, autocomplete: "family-name", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-sm text-slate-950 shadow-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"

        .space-y-2
          = f.label :email, t(".form.email"), class: "block text-sm font-medium text-slate-700"
          = f.email_field :email, autocomplete: "email", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-sm text-slate-950 shadow-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"

        .grid.gap-4.sm:grid-cols-2
          .space-y-2
            = f.label :password, t(".form.password"), class: "block text-sm font-medium text-slate-700"
            = f.password_field :password, autocomplete: "new-password", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-sm text-slate-950 shadow-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
            %p.text-xs.text-slate-500= t(".form.password_hint")
          .space-y-2
            = f.label :password_confirmation, t(".form.password_confirmation"), class: "block text-sm font-medium text-slate-700"
            = f.password_field :password_confirmation, autocomplete: "new-password", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-sm text-slate-950 shadow-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"

        .space-y-2
          = f.label :current_password, t(".form.current_password"), class: "block text-sm font-medium text-slate-700"
          = f.password_field :current_password, autocomplete: "current-password", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-sm text-slate-950 shadow-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
          %p.text-xs.text-slate-500= t(".form.current_password_hint")

        = f.submit t(".form.submit"), class: "w-full cursor-pointer rounded-lg bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"

    .mt-4.flex.justify-between.gap-3.text-sm
      = link_to t(".back"), root_path, class: "font-semibold text-slate-700 transition hover:text-slate-950"
      = button_to t(".cancel_account"), registration_path(resource_name), method: :delete, data: { turbo_confirm: t(".cancel_confirm") }, class: "font-semibold text-rose-700 transition hover:text-rose-800"
