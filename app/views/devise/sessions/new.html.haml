- content_for :title, t(".meta.title")

%main.min-h-screen.bg-stone-50.px-6.py-10.lg:px-8
  %div{ class: "mx-auto grid max-w-6xl items-center gap-10 lg:min-h-[calc(100vh-5rem)] lg:grid-cols-[1fr_460px]" }
    .max-w-2xl
      = link_to root_path, class: "inline-flex items-center gap-3" do
        %span.flex.h-10.w-10.items-center.justify-center.rounded-lg.bg-white.shadow-sm.ring-1.ring-slate-200
          = image_tag app_icon_path, alt: "", class: "h-6 w-6"
        %span.text-sm.font-semibold.text-slate-950= t("app.name")
      %p.mt-10.text-sm.font-semibold.text-emerald-700= t(".eyebrow")
      %h1.mt-4.text-4xl.font-semibold.leading-tight.text-slate-950.sm:text-5xl= t(".title")
      %p.mt-5.text-base.leading-7.text-slate-600= t(".subtitle")

      .mt-8.grid.gap-3.sm:grid-cols-3
        - t(".proof_points").each do |proof_point|
          .rounded-lg.border.border-slate-200.bg-white.p-4
            %p.text-sm.font-semibold.text-slate-950= proof_point[:title]
            %p.mt-2.text-sm.leading-6.text-slate-600= proof_point[:description]

    %div{ class: "rounded-lg border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/70 sm:p-8" }
      %h2.text-2xl.font-semibold.text-slate-950= t(".form.title")
      %p.mt-2.text-sm.leading-6.text-slate-600= t(".form.subtitle")

      = render "devise/shared/error_messages", resource: resource

      = form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mt-8 space-y-5" }) do |f|
        .space-y-2
          = f.label :email, t(".form.email"), class: "block text-sm font-medium text-slate-700"
          = f.email_field :email, autofocus: true, autocomplete: "email", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-sm text-slate-950 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"

        .space-y-2
          .flex.items-center.justify-between.gap-3
            = f.label :password, t(".form.password"), class: "block text-sm font-medium text-slate-700"
            = link_to t(".form.forgot_password"), new_password_path(resource_name), class: "text-sm font-semibold text-emerald-700 transition hover:text-emerald-800"
          = f.password_field :password, autocomplete: "current-password", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-sm text-slate-950 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"

        - if devise_mapping.rememberable?
          .flex.items-center.gap-3
            = f.check_box :remember_me, class: "h-4 w-4 rounded border-slate-300 text-emerald-600 focus:ring-emerald-500"
            = f.label :remember_me, t(".form.remember_me"), class: "text-sm text-slate-600"

        = f.submit t(".form.submit"), class: "w-full cursor-pointer rounded-lg bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"

      = render "devise/shared/links"
