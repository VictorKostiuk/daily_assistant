- content_for :title, t(".meta.title")

%main.min-h-screen.bg-stone-50.px-6.py-10.lg:px-8
  %div{ class: "mx-auto flex min-h-[calc(100vh-5rem)] max-w-md flex-col justify-center" }
    = link_to root_path, class: "mx-auto inline-flex items-center gap-3" do
      %span.flex.h-10.w-10.items-center.justify-center.rounded-lg.bg-white.shadow-sm.ring-1.ring-slate-200
        = image_tag app_icon_path, alt: "", class: "h-6 w-6"
      %span.text-sm.font-semibold.text-slate-950= t("app.name")

    %div{ class: "mt-10 rounded-lg border border-slate-200 bg-white p-6 shadow-xl shadow-slate-200/70 sm:p-8" }
      %h1.text-2xl.font-semibold.text-slate-950= t(".title")
      %p.mt-2.text-sm.leading-6.text-slate-600= t(".subtitle")

      = render "devise/shared/error_messages", resource: resource

      = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "mt-8 space-y-5" }) do |f|
        = f.hidden_field :reset_password_token

        .space-y-2
          = f.label :password, t(".form.password"), class: "block text-sm font-medium text-slate-700"
          = f.password_field :password, autofocus: true, autocomplete: "new-password", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-sm text-slate-950 shadow-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"
          - if @minimum_password_length
            %p.text-xs.text-slate-500= t(".form.password_hint", count: @minimum_password_length)

        .space-y-2
          = f.label :password_confirmation, t(".form.password_confirmation"), class: "block text-sm font-medium text-slate-700"
          = f.password_field :password_confirmation, autocomplete: "new-password", class: "block w-full rounded-lg border border-slate-300 bg-white px-3 py-3 text-sm text-slate-950 shadow-sm outline-none transition focus:border-emerald-500 focus:ring-4 focus:ring-emerald-100"

        = f.submit t(".form.submit"), class: "w-full cursor-pointer rounded-lg bg-emerald-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"

      = render "devise/shared/links"
