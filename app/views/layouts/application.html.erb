<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app.name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app.name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: "#{pwa_manifest_path(format: :json)}?v=#{public_asset_version(app_icon_filename)}" %>

    <link rel="icon" href="<%= public_icon_path("icon.png") %>" type="image/png">
    <% if public_asset_exists?("icon.svg") %>
      <link rel="icon" href="<%= public_icon_path("icon.svg") %>" type="image/svg+xml">
    <% end %>
    <link rel="apple-touch-icon" href="<%= public_icon_path("icon.png") %>">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body class="bg-stone-50 text-slate-950 antialiased">
    <%= render "shared/flash" %>
    <%= yield %>
  </body>
</html>
