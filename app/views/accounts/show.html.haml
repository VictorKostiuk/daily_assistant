- content_for :title, t(".meta.title")

%main.min-h-screen.bg-stone-50.px-6.py-10.lg:px-8
  .mx-auto.max-w-6xl
    .flex.flex-col.gap-6.sm:flex-row.sm:items-center.sm:justify-between
      = link_to root_path, class: "inline-flex items-center gap-3" do
        %span.flex.h-10.w-10.items-center.justify-center.rounded-lg.bg-white.shadow-sm.ring-1.ring-slate-200
          = image_tag app_icon_path, alt: "", class: "h-6 w-6"
        %span.text-sm.font-semibold.text-slate-950= t("app.name")

      .flex.flex-col.gap-3.sm:flex-row
        = link_to t(".actions.my_actions"), action_executions_path, class: "inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-800 shadow-sm transition hover:border-slate-400 hover:bg-slate-50"
        - if current_user.admin?
          = link_to t(".actions.admin"), admin_users_path, class: "inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-800 shadow-sm transition hover:border-slate-400 hover:bg-slate-50"
        = link_to t(".actions.edit"), edit_user_registration_path, class: "inline-flex items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-800 shadow-sm transition hover:border-slate-400 hover:bg-slate-50"
        = button_to t(".actions.sign_out"), destroy_user_session_path, method: :delete, class: "inline-flex w-full items-center justify-center rounded-lg bg-slate-950 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700 sm:w-auto"

    .mt-10
      %p.text-sm.font-semibold.text-emerald-700= t(".eyebrow")
      %h1.mt-3.text-3xl.font-semibold.leading-tight.text-slate-950= t(".title")
      %p.mt-3.max-w-2xl.text-base.leading-7.text-slate-600= t(".subtitle")

    %section.mt-8.grid.gap-5.lg:grid-cols-3
      .rounded-lg.border.border-slate-200.bg-white.p-6.shadow-sm
        %p.text-sm.font-semibold.text-slate-500= t(".summary.name")
        %p.mt-2.text-xl.font-semibold.text-slate-950= @user.first_name.presence || t(".empty")
        %p.text-xl.font-semibold.text-slate-950= @user.last_name.presence || t(".empty")
      .rounded-lg.border.border-slate-200.bg-white.p-6.shadow-sm
        %p.text-sm.font-semibold.text-slate-500= t(".summary.email")
        %p.mt-2.truncate.text-xl.font-semibold.text-slate-950= @user.email
      .rounded-lg.border.border-slate-200.bg-white.p-6.shadow-sm
        %p.text-sm.font-semibold.text-slate-500= t(".summary.status")
        %p.mt-2.text-xl.font-semibold.text-slate-950= t(".status_value", status: @user.status.humanize)

    %section{ class: "mt-8 grid gap-6 lg:grid-cols-[1fr_420px]" }
      .space-y-6
        .rounded-lg.border.border-slate-200.bg-white.p-6.shadow-sm
          .flex.flex-col.gap-4.sm:flex-row.sm:items-start.sm:justify-between
            .min-w-0
              %h2.text-xl.font-semibold.text-slate-950= t(".profile.title")
              %p.mt-2.text-sm.leading-6.text-slate-600= t(".profile.subtitle")
            = link_to t(".profile.edit"), edit_user_registration_path, class: "inline-flex items-center justify-center rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"

          .mt-6.grid.gap-4.sm:grid-cols-2
            .rounded-lg.bg-slate-50.p-4
              %p.text-xs.font-semibold.text-slate-500= t(".profile.fields.time_zone")
              %p.mt-2.text-sm.font-medium.text-slate-950= @user.time_zone.presence || t(".empty")
            .rounded-lg.bg-slate-50.p-4
              %p.text-xs.font-semibold.text-slate-500= t(".profile.fields.locale")
              %p.mt-2.text-sm.font-medium.text-slate-950= @user.locale.presence || t(".empty")
            .rounded-lg.bg-slate-50.p-4
              %p.text-xs.font-semibold.text-slate-500= t(".profile.fields.role")
              %p.mt-2.text-sm.font-medium.text-slate-950= @user.role.humanize
            .rounded-lg.bg-slate-50.p-4
              %p.text-xs.font-semibold.text-slate-500= t(".profile.fields.member_since")
              %p.mt-2.text-sm.font-medium.text-slate-950= l(@user.created_at.to_date, format: :long)

        .rounded-lg.border.border-slate-200.bg-white.p-6.shadow-sm
          .flex.items-start.justify-between.gap-4
            .min-w-0
              %h2.text-xl.font-semibold.text-slate-950= t(".services.title")
              %p.mt-2.text-sm.leading-6.text-slate-600= t(".services.subtitle")
            %span.rounded-full.bg-slate-100.px-3.py-1.text-xs.font-semibold.text-slate-600= t(".services.count", count: @connected_integrations_count)

          .mt-6.grid.gap-4.md:grid-cols-2
            - connection_cards.each do |card|
              = render "accounts/connection_card", card: card

      .space-y-6
        %section#telegram-integration.rounded-lg.border.border-slate-200.bg-white.p-6.shadow-sm
          %h2.text-xl.font-semibold.text-slate-950= t(".telegram.title")
          %p.mt-2.text-sm.leading-6.text-slate-600= t(".telegram.subtitle")

          - if @telegram_account
            .mt-6.space-y-4
              .rounded-lg.bg-emerald-50.p-4
                %p.text-xs.font-semibold.text-emerald-700= t(".telegram.connected")
                %p.mt-2.text-sm.font-medium.text-emerald-950= @telegram_account.display_name.presence || t(".telegram.no_username")
              .grid.gap-4
                .rounded-lg.bg-slate-50.p-4
                  %p.text-xs.font-semibold.text-slate-500= t(".telegram.fields.chat_id")
                  %p.mt-2.text-sm.font-medium.text-slate-950= @telegram_account.telegram_chat_id || t(".empty")
                .rounded-lg.bg-slate-50.p-4
                  %p.text-xs.font-semibold.text-slate-500= t(".telegram.fields.last_seen")
                  %p.mt-2.text-sm.font-medium.text-slate-950= @telegram_account.last_interaction_at ? l(@telegram_account.last_interaction_at, format: :long) : t(".empty")
              = button_to t(".telegram.disconnect"), integrations_telegram_connection_path, method: :delete, data: { turbo_confirm: t(".telegram.disconnect_confirm") }, class: "inline-flex w-full items-center justify-center rounded-lg border border-rose-200 bg-white px-4 py-2 text-sm font-semibold text-rose-700 shadow-sm transition hover:border-rose-300 hover:bg-rose-50"
          - else
            .mt-6.space-y-4
              .rounded-lg.bg-amber-50.p-4
                %p.text-xs.font-semibold.text-amber-700= t(".telegram.not_connected")
                %p.mt-2.text-sm.leading-6.text-amber-800= t(".telegram.connect_hint")
              = button_to t(".telegram.connect"), integrations_telegram_connection_path, form: external_redirect_form_options, class: "inline-flex w-full items-center justify-center rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"

        %section#google-integration.rounded-lg.border.border-slate-200.bg-white.p-6.shadow-sm
          %h2.text-xl.font-semibold.text-slate-950= t(".google.title")
          %p.mt-2.text-sm.leading-6.text-slate-600= t(".google.subtitle")

          - if google_connection_state == :connected
            .mt-6.space-y-4
              .rounded-lg.bg-emerald-50.p-4
                %p.text-xs.font-semibold.text-emerald-700= t(".google.connected")
                %p.mt-2.truncate.text-sm.font-medium.text-emerald-950= @google_integration.external_account_email.presence || t(".empty")
              .grid.gap-4
                .rounded-lg.bg-slate-50.p-4
                  %p.text-xs.font-semibold.text-slate-500= t(".google.fields.connected_at")
                  %p.mt-2.text-sm.font-medium.text-slate-950= @google_integration.connected_at ? l(@google_integration.connected_at, format: :long) : t(".empty")
                .rounded-lg.bg-slate-50.p-4
                  %p.text-xs.font-semibold.text-slate-500= t(".google.fields.services")
                  - if google_services.any?
                    %ul.mt-2.space-y-1
                      - google_services.each do |service|
                        %li.text-sm.font-medium.text-slate-950= google_service_label(service)
                  - else
                    %p.mt-2.text-sm.leading-6.text-slate-600= t(".google.no_services")
              = button_to t(".google.disconnect"), integrations_google_connection_path, method: :delete, data: { turbo_confirm: t(".google.disconnect_confirm") }, class: "inline-flex w-full items-center justify-center rounded-lg border border-rose-200 bg-white px-4 py-2 text-sm font-semibold text-rose-700 shadow-sm transition hover:border-rose-300 hover:bg-rose-50"
          - elsif google_connection_state == :reconnect_required
            .mt-6.space-y-4
              .rounded-lg.bg-rose-50.p-4
                %p.text-xs.font-semibold.text-rose-700= t(".google.reconnect_required")
                %p.mt-2.text-sm.leading-6.text-rose-800= t(".google.reconnect_hint")
              = button_to t(".google.reconnect"), google_oauth_request_path, form: external_redirect_form_options, class: "inline-flex w-full items-center justify-center rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"
          - else
            .mt-6.space-y-4
              .rounded-lg.bg-amber-50.p-4
                %p.text-xs.font-semibold.text-amber-700= t(".google.not_connected")
                %p.mt-2.text-sm.leading-6.text-amber-800= t(".google.connect_hint")
              = button_to t(".google.connect"), google_oauth_request_path, form: external_redirect_form_options, class: "inline-flex w-full items-center justify-center rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"

        .rounded-lg.border.border-slate-200.bg-slate-950.p-6.text-white.shadow-sm
          %h2.text-xl.font-semibold= t(".next.title")
          %p.mt-2.text-sm.leading-6.text-slate-300= t(".next.subtitle")
          = link_to t(".next.cta"), edit_user_registration_path, class: "mt-5 inline-flex items-center justify-center rounded-lg bg-white px-4 py-2 text-sm font-semibold text-slate-950 shadow-sm transition hover:bg-emerald-100"
