- content_for :title, t(".meta.title")

%main.min-h-screen.bg-stone-50.px-6.py-10.lg:px-8
  .mx-auto.max-w-6xl
    %header.flex.items-center.justify-between
      %div
        %h1.text-2xl.font-semibold.text-slate-950= t(".heading")
        %p.mt-1.text-sm.text-slate-500= t(".subtitle", count: @pagination.total)
      = link_to t("admin.nav.actions"), admin_action_executions_path, class: "rounded-md border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"

    .mt-8.overflow-hidden.rounded-lg.border.border-slate-200.bg-white.shadow-sm
      - if @pagination.records.empty?
        .p-6.text-sm.text-slate-500= t(".empty")
      - else
        %table.min-w-full.divide-y.divide-slate-200
          %thead.bg-slate-50
            %tr
              %th.px-4.py-3.text-left.text-xs.font-medium.uppercase.tracking-wide.text-slate-500= t(".columns.email")
              %th.px-4.py-3.text-left.text-xs.font-medium.uppercase.tracking-wide.text-slate-500= t(".columns.name")
              %th.px-4.py-3.text-left.text-xs.font-medium.uppercase.tracking-wide.text-slate-500= t(".columns.role")
              %th.px-4.py-3.text-left.text-xs.font-medium.uppercase.tracking-wide.text-slate-500= t(".columns.status")
              %th.px-4.py-3.text-left.text-xs.font-medium.uppercase.tracking-wide.text-slate-500= t(".columns.last_seen")
              %th.px-4.py-3.text-left.text-xs.font-medium.uppercase.tracking-wide.text-slate-500= t(".columns.actions_count")
              %th.px-4.py-3
          %tbody.divide-y.divide-slate-100
            - @pagination.records.each do |user|
              %tr
                %td.px-4.py-3.text-sm.text-slate-950= user.email
                %td.px-4.py-3.text-sm.text-slate-700= user_full_name(user)
                %td.px-4.py-3.text-sm.text-slate-700= user.role.humanize
                %td.px-4.py-3.text-sm.text-slate-700= user.status.humanize
                %td.px-4.py-3.text-sm.text-slate-500= user.last_seen_at ? l(user.last_seen_at, format: :long) : t(".never")
                %td.px-4.py-3.text-sm.text-slate-500= @action_counts.fetch(user.id, 0)
                %td.px-4.py-3.text-right.text-sm
                  = link_to t(".view_actions"), admin_user_path(user), class: "font-medium text-emerald-700 hover:text-emerald-800"

    = render "admin/shared/pagination", pagination: @pagination
