- content_for :title, t(".meta.title", email: @user.email)

%main.min-h-screen.bg-stone-50.px-6.py-10.lg:px-8
  .mx-auto.max-w-6xl
    = link_to t(".back"), admin_users_path, class: "text-sm text-slate-500 hover:text-slate-700"

    %header.mt-4
      %h1.text-2xl.font-semibold.text-slate-950= user_full_name(@user)
      %p.mt-1.text-sm.text-slate-500= t(".subtitle", email: @user.email, date: l(@user.created_at.to_date, format: :long))

    .mt-6.rounded-lg.border.border-slate-200.bg-white.p-6.shadow-sm
      %h2.text-lg.font-semibold.text-slate-950= t(".account_heading")
      - if @user == current_user
        %p.mt-3.text-sm.text-slate-500= t(".cannot_edit_self")
      - else
        = form_with model: @user, url: admin_user_path(@user), method: :patch, class: "mt-4 flex flex-wrap items-end gap-4" do |form|
          .flex.flex-col.gap-1
            = form.label :role, t(".role_label"), class: "text-xs font-medium text-slate-500"
            = form.select :role, User.roles.keys.map { |role| [ role.humanize, role ] }, {}, class: "rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900"
          .flex.flex-col.gap-1
            = form.label :status, t(".status_label"), class: "text-xs font-medium text-slate-500"
            = form.select :status, User.statuses.keys.map { |status| [ status.humanize, status ] }, {}, class: "rounded-md border border-slate-300 px-3 py-2 text-sm text-slate-900"
          = form.submit t(".save"), data: { turbo_confirm: t(".confirm") }, class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-emerald-700"

    %h2.mt-8.text-lg.font-semibold.text-slate-950= t(".actions_heading")

    .mt-4.overflow-hidden.rounded-lg.border.border-slate-200.bg-white.shadow-sm
      - if @pagination.records.empty?
        .p-6.text-sm.text-slate-500= t(".empty")
      - else
        %table.min-w-full.divide-y.divide-slate-200
          %thead.bg-slate-50
            %tr
              %th.px-4.py-3.text-left.text-xs.font-medium.uppercase.tracking-wide.text-slate-500= t("admin.action_executions.index.columns.when")
              %th.px-4.py-3.text-left.text-xs.font-medium.uppercase.tracking-wide.text-slate-500= t("admin.action_executions.index.columns.action")
              %th.px-4.py-3.text-left.text-xs.font-medium.uppercase.tracking-wide.text-slate-500= t("admin.action_executions.index.columns.source")
              %th.px-4.py-3.text-left.text-xs.font-medium.uppercase.tracking-wide.text-slate-500= t("admin.action_executions.index.columns.status")
              %th.px-4.py-3.text-left.text-xs.font-medium.uppercase.tracking-wide.text-slate-500= t("admin.action_executions.index.columns.detail")
              %th.px-4.py-3.text-left.text-xs.font-medium.uppercase.tracking-wide.text-slate-500= t("admin.action_executions.index.columns.duration")
          %tbody.divide-y.divide-slate-100
            - @pagination.records.each do |execution|
              = render "admin/action_executions/row", execution: execution, show_user: false

    = render "admin/shared/pagination", pagination: @pagination
